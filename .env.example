# ==============================================================================
# LazyMail — Environment Configuration Example
# Copy this file to .env on your VPS if you wish to override default variables:
#   cp .env.example .env
# ==============================================================================

# Internal bind address (Default: 127.0.0.1 to protect port 3011 from public internet)
HOST_BIND=127.0.0.1

# External port on host machine (Default: 3011, avoids 3000-3010 in use)
HOST_PORT=3011

# Optional: Custom encryption key for sensitive credentials.
# If left empty, LazyMail auto-generates and persists a key in ./data/.secret.key
# LAZYMAIL_SECRET_KEY=

# Server public IPv4 address (Optional: automatically detected if omitted)
# SERVER_IP=
